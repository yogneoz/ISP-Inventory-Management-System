{
  "name": "inventory-management-system",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise Multi-Branch Inventory Management System, Device Tracking, VAT & Fiscal Closing",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "integrity:check": "node scripts/integrity_check.mjs",
    "smoke": "node scripts/smoke_test.mjs",
    "bench:write": "node scripts/bench_write_latency.mjs",
    "setup:pg": "node scripts/setup_db.js",
    "setup:postgres": "bash scripts/setup_postgres.sh",
    "lint": "tsc --noEmit",
    "test": "tsc --noEmit && tsx --test tests/*.test.ts",
    "check:no-inline-sql": "tsx scripts/check_no_inline_sql.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "body-parser": "^2.3.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.0",
    "qs": "^6.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "uuid": "^14.0.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "express": {
      "qs": "$qs"
    },
    "body-parser": {
      "qs": "$qs"
    }
  }
}
