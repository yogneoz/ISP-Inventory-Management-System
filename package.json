{
  "name": "inventory-management-system",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise Multi-Branch Inventory Management System, Device Tracking, VAT & Fiscal Closing",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "integrity:check": "node scripts/integrity_check.mjs",
    "check:partitions": "tsx scripts/check_partitions.ts",
    "repair:partitions": "tsx scripts/repair_default_partitions.ts",
    "smoke": "node scripts/smoke_test.mjs",
    "bench:write": "node scripts/bench_write_latency.mjs",
    "perf:bootstrap": "node scripts/load_probe_bootstrap.mjs",
    "measure:bootstrap": "node scripts/measure_bootstrap_payload.mjs",
    "backup": "bash scripts/backup.sh",
    "check:restore-drill": "node scripts/check_restore_drill.mjs",
    "bench:phase0a": "tsx scripts/phase0a_baseline.ts",
    "bench:phase0b": "tsx scripts/phase0b_baseline.ts",
    "setup:pg": "node scripts/setup_db.js",
    "setup:postgres": "bash scripts/setup_postgres.sh",
    "lint": "tsc --noEmit",
    "test": "tsc --noEmit && node scripts/run_tests.mjs",
    "check:no-inline-sql": "tsx scripts/check_no_inline_sql.ts",
    "check:no-raw-dialogs": "tsx scripts/check_no_raw_dialogs.ts",
    "check:branch-predicates": "tsx scripts/check_branch_predicates.ts",
    "check:audit-await": "tsx scripts/check_audit_await.ts",
    "check:contract-parity": "tsx scripts/check_contract_parity.ts",
    "docs:sync-tests": "tsx scripts/syncTestCounts.ts",
    "test:durations": "node scripts/measureTestDurations.mjs",
    "shards:build": "node scripts/buildTestShardPlan.mjs",
    "check:shard-plan": "node scripts/checkTestShardPlan.mjs",
    "accounting-outbox:pending": "tsx scripts/accounting_outbox.ts pending",
    "accounting-outbox:flush": "tsx scripts/accounting_outbox.ts flush",
    "read-models:pending": "tsx scripts/read_models.ts pending",
    "read-models:flush": "tsx scripts/read_models.ts flush",
    "read-models:rebuild": "tsx scripts/read_models.ts rebuild",
    "verify:pgbouncer": "tsx scripts/verify_pgbouncer_pooling.ts",
    "verify:redis-invalidation": "tsx scripts/verify_redis_invalidation.ts",
    "verify:apikey-rpm": "tsx scripts/verify_apikey_rpm.ts",
    "verify:catalog-roundtrips": "node scripts/verify_catalog_roundtrips.mjs",
    "check:bundle-budget": "node scripts/check_bundle_budget.mjs",
    "ci:local": "node scripts/ci_local.mjs",
    "check:boot-timing": "node scripts/check_boot_timing.mjs",
    "audit:bs-dates": "tsx scripts/audit_bs_calendar_dates.ts",
    "verify:fresh-install": "node scripts/verify_fresh_install.mjs",
    "seed:verify": "tsx scripts/seed_verification_data.ts",
    "check:demo-coverage": "tsx scripts/check_demo_coverage.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "body-parser": "^2.3.0",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "pdfmake": "^0.3.13",
    "pg": "^8.23.0",
    "qs": "^6.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "redis": "^5.12.2",
    "uuid": "^14.0.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.14.0",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^27.4.0",
    "pdfjs-dist": "^4.10.38",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1",
      "minimatch": "^11.0.1"
    },
    "source-map-js": "^1.2.2",
    "express": {
      "qs": "$qs"
    },
    "body-parser": {
      "qs": "$qs"
    }
  }
}
