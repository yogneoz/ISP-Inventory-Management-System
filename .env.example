# Optional Gemini AI assistant (leave unset to use built-in offline insights)
# GEMINI_API_KEY=

# Public app URL (optional)
# APP_URL=https://erp.example.com

# Leave empty to use same-origin Express API (recommended)
# VITE_API_BASE_URL=

# PostgreSQL Database Configuration (PRIMARY durable write path when reachable)
# If Postgres is offline the app falls back to pg-mem / JSON automatically.
DATABASE_URL="postgres://inventory_user:securepassword@localhost:5432/inventory_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="inventory_db"
POSTGRES_USER="inventory_user"
POSTGRES_PASSWORD="securepassword"

# Redis Session Store (optional but recommended for multi-instance / production)
# When reachable, auth sessions are shared across PM2 workers and survive restarts.
# If unset or unreachable, the server automatically falls back to in-memory sessions.
# REDIS_URL="redis://localhost:6379/0"
# Or discrete settings:
# REDIS_HOST="localhost"
# REDIS_PORT="6379"
# REDIS_PASSWORD=""
# REDIS_DB="0"

# Optional: Seed sample demo data on first boot (false by default)
SEED_DUMMY_DATA="false"

# --- Production hardening ---
# TRUST_PROXY=true
# LOG_LEVEL=info
# STRICT_PASSWORD_POLICY=true
# MIN_PASSWORD_LENGTH=10
# LOGIN_RATE_LIMIT_MAX=20
# API_RATE_LIMIT_MAX=600
# DISABLE_RATE_LIMIT=false
# REQUIRE_MIGRATIONS=false
# PM2_INSTANCES=1
# SSE_REDIS_CHANNEL=izone:sse
# DISABLE_SSE_REDIS=false
# JSON_BODY_LIMIT=25mb
