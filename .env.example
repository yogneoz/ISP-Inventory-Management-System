# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Backend REST API URL
# Leave empty to use default Node/Express API routes in server.ts
# Set to "http://localhost:8000/api/v1" when running Django backend
VITE_API_BASE_URL=""

# PostgreSQL Database Configuration (PRIMARY durable write path when reachable)
# If Postgres is offline the app falls back to pg-mem / JSON automatically.
DATABASE_URL="postgres://inventory_user:securepassword@localhost:5432/inventory_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="inventory_db"
POSTGRES_USER="inventory_user"
POSTGRES_PASSWORD="securepassword"

# Redis Session Store (optional but recommended for multi-instance / production)
# When reachable, auth sessions are shared across PM2 workers and survive restarts.
# If unset or unreachable, the server automatically falls back to in-memory sessions.
# REDIS_URL="redis://localhost:6379/0"
# Or discrete settings:
# REDIS_HOST="localhost"
# REDIS_PORT="6379"
# REDIS_PASSWORD=""
# REDIS_DB="0"

# Optional: Seed sample demo data on first boot (false by default)
SEED_DUMMY_DATA="false"

# --- Production hardening ---
# TRUST_PROXY=true
# LOG_LEVEL=info
# STRICT_PASSWORD_POLICY=true
# MIN_PASSWORD_LENGTH=10
# LOGIN_RATE_LIMIT_MAX=20
# API_RATE_LIMIT_MAX=600
# DISABLE_RATE_LIMIT=false
# REQUIRE_MIGRATIONS=false
# PM2_INSTANCES=1
# SSE_REDIS_CHANNEL=izone:sse
# DISABLE_SSE_REDIS=false
# JSON_BODY_LIMIT=25mb
