# =============================================================================
# IZone ERP — environment template
# Copy to .env and adjust. Never commit real secrets.
# =============================================================================

# Runtime
NODE_ENV=development
PORT=3000
# TRUST_PROXY=true
# LOG_LEVEL=info
# JSON_BODY_LIMIT=25mb

# Optional Gemini AI assistant (unset = offline canned insights)
# GEMINI_API_KEY=
# APP_URL=https://erp.example.com
# VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# PostgreSQL (PRIMARY durable database)
# In production (NODE_ENV=production) the app FAILS TO START without Postgres
# unless you explicitly set ALLOW_DB_FALLBACK=true (not recommended).
# -----------------------------------------------------------------------------
DATABASE_URL="postgres://inventory_user:securepassword@localhost:5432/inventory_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="inventory_db"
POSTGRES_USER="inventory_user"
POSTGRES_PASSWORD="securepassword"
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT_MS=5000

# Force Postgres even in development (recommended once DB is installed):
# REQUIRE_POSTGRES=true
# Allow demo fallbacks in production (DANGEROUS — data not durable):
# ALLOW_DB_FALLBACK=true
# DISABLE_PG_MEM=true
# REQUIRE_MIGRATIONS=true

# -----------------------------------------------------------------------------
# Redis (sessions + multi-instance SSE) — recommended for production
# -----------------------------------------------------------------------------
# REDIS_URL="redis://localhost:6379/0"
# REDIS_HOST="localhost"
# REDIS_PORT="6379"
# REDIS_PASSWORD=
# REDIS_DB="0"
# SSE_REDIS_CHANNEL=izone:sse
# DISABLE_SSE_REDIS=false

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# STRICT_PASSWORD_POLICY=true
# MIN_PASSWORD_LENGTH=10
# LOGIN_RATE_LIMIT_MAX=20
# API_RATE_LIMIT_MAX=600
# DISABLE_RATE_LIMIT=false

# -----------------------------------------------------------------------------
# Data
# -----------------------------------------------------------------------------
SEED_DUMMY_DATA="false"
# PM2_INSTANCES=1
