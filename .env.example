# =============================================================================
# Inventory ERP — environment template
# Copy to .env and adjust. Never commit real secrets.
#
# Every variable named in this file is read by the code (server, client build
# or scripts). Variables that nothing read were removed; the guard test
# tests/envDocs.guard.test.ts fails if one is added back without a reader.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# JSON body limit for the Express API (express.json limit). Accepts any
# body-parser size string, e.g. 25mb. Default when unset: 1mb. Oversized
# bodies are rejected with 413 (the central error handler passes
# body-parser's 4xx status through instead of masking it as a 500).
JSON_BODY_LIMIT=25mb

# Reverse proxy — set ONLY when the app runs behind a proxy/load balancer.
# Express then honors X-Forwarded-For, so req.ip (the key for the login rate
# limiter and the per-IP SSE connection cap) is the real client instead of
# the proxy's own IP — without it every user would share one rate-limit
# bucket. Off unless the value is exactly 1 or true; on a direct LAN
# deployment (the current topology) leave it unset so client-supplied
# headers are never trusted.
# TRUST_PROXY=true

# SSE stream guard: max simultaneous /api/sync/stream connections per client
# address. Set to a number >= 1. Default when unset: 6.
# SSE_MAX_CONNECTIONS_PER_IP=6
# Set to 1/true to disable the SSE connection cap (tests/dev only).
# SSE_RATE_LIMIT_DISABLED=false
#
# NOTE on numeric env vars: PORT, JSON_BODY_LIMIT, PG_POOL_MAX,
# PG_CONNECT_TIMEOUT_MS, SSE_MAX_CONNECTIONS_PER_IP, AUTH_RATE_LIMIT_MAX,
# AUTH_RATE_LIMIT_WINDOW_MS and RETURNS_APPROVAL_THRESHOLD_NPR are parsed
# strictly — an empty, garbage, zero or out-of-range value is rejected with a
# warning in the server log and the documented fallback is used, so a .env
# typo can never crash the server or silently disable a security control.
# Boolean flags (TRUST_PROXY, AUTH_RATE_LIMIT_DISABLED,
# SSE_RATE_LIMIT_DISABLED, DISABLE_HMR) accept only 1/true; anything else
# means "off".

# Build-time override of the API base URL baked into the Vite client bundle
# (leave empty to call the same origin that served the page).
# VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Auth rate limiting (login / forgot-password brute-force mitigation)
# Sliding-window limiter with TWO independent buckets per request:
#   1. per client IP  — counts EVERY attempt (stops one host spraying accounts)
#   2. per account    — GLOBAL across IPs, recorded on FAILURES only; a
#      successful login clears its own hit, so a distributed attack on one
#      account is throttled without letting attackers lock that account out
#      or collateral-lock other accounts.
# State is in-memory (resets on restart) — fine for this single-instance
# deployment; multi-instance would need a shared store.
# -----------------------------------------------------------------------------
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_DISABLED=false

# -----------------------------------------------------------------------------
# PostgreSQL (required)
# The server FAILS TO START when PostgreSQL is unavailable: startup runs
# scripts/schema.sql through dbBoot and aborts if no connection can be
# established (server/index.ts exits non-zero).
# -----------------------------------------------------------------------------
DATABASE_URL="postgres://inventory_user:securepassword@localhost:5432/inventory_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="inventory_db"
POSTGRES_USER="inventory_user"
POSTGRES_PASSWORD="securepassword"
# Pool sizing — both are guarded integers (warning + documented default when
# the value is empty/garbage/out of range). PG_POOL_MAX is how many
# connections the pool may open; PG_CONNECT_TIMEOUT_MS is how long a query
# waits for a free/new connection before failing.
# PG_POOL_MAX=20
# PG_CONNECT_TIMEOUT_MS=2000

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
AUTH_TOKEN_SECRET="replace-with-a-long-random-production-secret"

# -----------------------------------------------------------------------------
# Business thresholds
# -----------------------------------------------------------------------------
# Sales / purchase returns at or above this NPR amount are held for approval
# instead of posting immediately (sales + procurement controllers).
# RETURNS_APPROVAL_THRESHOLD_NPR=200000

# -----------------------------------------------------------------------------
# Script-only variables — NOT read by the server at runtime
# -----------------------------------------------------------------------------
# PORT_TO_BOOT=3557          # scripts/verify_fresh_install.mjs — throwaway boot port
# FRESH_INSTALL_ADMIN_URL=   # scripts/verify_fresh_install.mjs — admin DB URL for cleanup
# SMOKE_BASE_URL=            # scripts/smoke_test.mjs — server to probe
# SMOKE_USER_EMAIL=          # scripts/smoke_test.mjs + bench_write_latency.mjs — login
# SMOKE_USER_PASSWORD=       # scripts/smoke_test.mjs — login
# BASE_URL=                  # scripts/bench_write_latency.mjs — server to probe
# N=12                       # scripts/bench_write_latency.mjs — request count
# DISABLE_HMR=true           # vite.config.ts — kill dev HMR + file watching
