# =============================================================================
# Inventory ERP — environment template
# Copy to .env and adjust. Never commit real secrets.
# =============================================================================

# Runtime
REQUIRE_POSTGRES=true
NODE_ENV=development
PORT=3000
# TRUST_PROXY=true
# LOG_LEVEL=info
# JSON body limit for the Express API (express.json limit). Accepts any
# body-parser size string, e.g. 25mb. Default when unset: 1mb.
JSON_BODY_LIMIT=25mb

# SSE stream guard: max simultaneous /api/sync/stream connections per client
# address. Set to a number >= 1. Default when unset: 6.
# SSE_MAX_CONNECTIONS_PER_IP=6
# Set to 1/true to disable the SSE connection cap (tests/dev only).
# SSE_RATE_LIMIT_DISABLED=false
#
# NOTE on numeric env vars: PORT, JSON_BODY_LIMIT, SSE_MAX_CONNECTIONS_PER_IP,
# AUTH_RATE_LIMIT_MAX and AUTH_RATE_LIMIT_WINDOW_MS are parsed strictly — an
# empty, garbage, zero or out-of-range value is rejected with a ⚠️ warning in
# the server log and the documented fallback is used, so a .env typo can
# never crash the server or disable a security control silently.

# APP_URL=https://erp.example.com
# VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Auth rate limiting (login / forgot-password brute-force mitigation)
# Sliding-window limiter, two buckets per request: per client IP and per
# IP+account pair. State is in-memory (resets on restart); a multi-instance
# deployment needs a shared store (see Redis section).
# -----------------------------------------------------------------------------
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_DISABLED=false

# -----------------------------------------------------------------------------
# PostgreSQL (required)
# The server fails to start when PostgreSQL is unavailable.
# -----------------------------------------------------------------------------
DATABASE_URL="postgres://inventory_user:securepassword@localhost:5432/inventory_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="inventory_db"
POSTGRES_USER="inventory_user"
POSTGRES_PASSWORD="securepassword"
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT_MS=5000

# REQUIRE_MIGRATIONS=true
# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
AUTH_TOKEN_SECRET="replace-with-a-long-random-production-secret"
# STRICT_PASSWORD_POLICY=true
# MIN_PASSWORD_LENGTH=10
# LOGIN_RATE_LIMIT_MAX=20
# API_RATE_LIMIT_MAX=600
# DISABLE_RATE_LIMIT=false

# -----------------------------------------------------------------------------
# Data
# -----------------------------------------------------------------------------
SEED_DUMMY_DATA="false"
# PM2_INSTANCES=1
